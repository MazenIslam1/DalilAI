# ===========================================
# Dalil AI - Environment Configuration
# ===========================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values below
# 3. NEVER commit the .env file to git
# ===========================================

# --- Google Gemini API Key ---
# Get your key from: https://aistudio.google.com/
# Click "Get API Key" → Create API Key
GOOGLE_API_KEY=your_google_api_key_here

# --- Application Settings ---
APP_NAME=Dalil AI
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Security ---
# Generate a secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=change_this_to_a_random_secret_key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=uploads
ALLOWED_EXTENSIONS=.csv,.xlsx,.xls

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./dalil_ai.db

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30
GEMINI_RATE_LIMIT_RPM=5

# --- Caching ---
CACHE_TTL_SECONDS=3600
MAX_CACHE_SIZE=100

# --- AI Settings ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1
MAX_SAMPLE_ROWS=10
MAX_CONTEXT_TOKENS=8000
CONVERSATION_SUMMARY_THRESHOLD=6
